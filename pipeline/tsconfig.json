{
  // The boundary pipeline runs directly in Node.js 22+ (type stripping), so
  // its imports use .ts extensions and only erasable TypeScript syntax.
  // "bundler" resolution also lets the contract test import app modules.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
