{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Only the type packages the app imports; no Node.js globals in app code.
    "types": []
  },
  // The boundary pipeline (Node.js) and the website (web/) have their own tsconfigs.
  "exclude": ["__tests__", "pipeline", "test", "web", "node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios"]
}
