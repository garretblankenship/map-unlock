---
import FogMap from '../components/FogMap.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const features = [
  ['Fog of war for real life', 'The map starts covered. Everywhere you go clears it, so you can see exactly where you’ve been and where you haven’t.'],
  ['A score for every place', 'Neighbourhoods, cities, counties, parks and forests, states and countries each get a percentage. Lakes and rivers don’t count against you.'],
  ['Made for the outdoors', 'Works with no signal. Save an area before a trip and the map, its lakes and rivers, and its park boundaries come with you.'],
  ['Keeps going in your pocket', 'Background exploring keeps clearing the fog on walks, hikes and drives, and eases off the GPS when you stop to save battery.'],
  ['Share your progress', 'A card with a region’s outline and your percentage. Never the streets you’ve explored.'],
  ['Private by design', 'Your location history stays on your phone. No accounts, no ads, no tracking.'],
];
const steps = [
  ['Explore', 'Walk, hike, cycle, drive or ride the train. Everything within 50 m of your path is unlocked.'],
  ['Discover', 'Each place you pass through is added to your list with its own progress bar.'],
  ['Complete', 'Pick a goal — your neighbourhood, a national park, a whole state — and work towards 100%.'],
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">A real-world exploration game</p>
        <h1>Unlock the map by exploring the world.</h1>
        <p class="lede">{site.description}</p>
        <div class="stores">
          {
            site.appStoreUrl ? (
              <a class="button" href={site.appStoreUrl}>Download on the App Store</a>
            ) : (
              <span class="button" aria-disabled="true">App Store — coming soon</span>
            )
          }
          {
            site.playStoreUrl ? (
              <a class="button secondary" href={site.playStoreUrl}>Get it on Google Play</a>
            ) : (
              <span class="button secondary" aria-disabled="true">Google Play — coming soon</span>
            )
          }
        </div>
      </div>
      <FogMap />
    </div>
  </section>

  <section class="wrap">
    <h2 class="section-title">How it works</h2>
    <ol class="steps">
      {
        steps.map(([title, body], i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap">
    <h2 class="section-title">Features</h2>
    <div class="features">
      {
        features.map(([title, body]) => (
          <div class="feature">
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <div class="privacy">
      <h2>Your location stays on your phone</h2>
      <p>
        Open World Life works out where you’ve been on your device. There are no accounts and no servers holding your
        data, and nothing is sold or shared. <a href="/privacy/">Read the privacy policy</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 48px 0 24px;
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 820px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
      justify-items: start;
    }
  }
  .kicker {
    color: var(--accent-strong);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 13px;
    margin: 0;
  }
  h1 {
    font-size: clamp(34px, 7vw, 54px);
    line-height: 1.08;
    margin: 10px 0 16px;
  }
  .lede {
    font-size: 19px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section-title {
    font-size: 26px;
    margin: 56px 0 18px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .steps li,
  .feature {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .steps h3,
  .feature h3 {
    margin: 6px 0 4px;
    font-size: 18px;
  }
  .steps p,
  .feature p {
    margin: 0;
    color: var(--muted);
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 800;
  }
  .features {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .privacy {
    margin-top: 56px;
    background: var(--card-brand);
    color: #ffffff;
    border-radius: 20px;
    padding: 28px 24px;
  }
  .privacy h2 {
    margin: 0 0 8px;
  }
  .privacy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }
  .privacy a {
    color: #8fe3b8;
  }
</style>
